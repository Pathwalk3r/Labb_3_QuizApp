<UserControl x:Class="QuizApp.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:local="clr-namespace:QuizApp.Views"
             mc:Ignorable="d" 
             DataContext="{Binding MenuViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="_New Question Pack" 
                          Icon="{fa:Icon FolderPlus}"
                          Command="{Binding Path=ChangePackNameCommand}"/>
                <MenuItem Header="_Select Question Pack">
                    <MenuItem Header="{Binding ActivePack.Name}"/>
                </MenuItem>
                <MenuItem 
                    Header="E_xit"
                    Command="{Binding Path=ExitApplicationCommand}"
                    InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem 
                Header="_Edit" 
                Command="{Binding MainWindowViewModel.ShowConfigurationCommand}"/>
            <MenuItem 
                Header="View">
                <MenuItem 
                    Header="Main Menu"
                    Command="{Binding MainWindowViewModel.ShowStartCommand}"
                    />
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
