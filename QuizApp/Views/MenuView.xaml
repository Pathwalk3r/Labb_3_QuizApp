<UserControl x:Class="QuizApp.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:local="clr-namespace:QuizApp.Views"
             mc:Ignorable="d" 
             DataContext="{Binding MenuViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="_New Question Pack" 
                          Icon="{fa:Icon FolderPlus}"
                          Command="{Binding CreatePackCommand}"/>
                <MenuItem Header="_Select Question Pack"
                        ItemsSource="{Binding SavedPacks}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="Command"
                                    Value="{Binding DataContext.SelectPackCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:MenuView}}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem 
                    Header="E_xit"
                    Command="{Binding Path=ExitApplicationCommand}"
                    InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem 
                Header="_Edit" 
                Command="{Binding MainWindowViewModel.ShowConfigurationCommand}"/>
            <MenuItem 
                Header="View">
                <MenuItem 
                    Header="Main Menu"
                    Command="{Binding MainWindowViewModel.ShowStartCommand}"
                    />
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
