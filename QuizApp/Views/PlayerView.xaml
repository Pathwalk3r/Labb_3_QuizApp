<UserControl x:Class="QuizApp.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizApp.Views"
             mc:Ignorable="d"
             FontSize="24"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock 
            Text="{Binding ActivePack.Questions[0].Query}" 
            FontSize="24" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"/>
        <WrapPanel 
            Grid.Row="1" 
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="350">
            <Button Content="{Binding ActivePack.Questions[0].CorrectAnswer}" Width="150" Padding="5 5 5 5" Margin="15 15 15 15"/>
            <Button Content="{Binding ActivePack.Questions[0].IncorrectAnswer[0]}" Width="150" Padding="5 5 5 5" Margin="0 15 15 15"/>
            <Button Content="{Binding ActivePack.Questions[0].IncorrectAnswer[1]}" Width="150" Padding="5 5 5 5" Margin="15 0 15 15"/>
            <Button Content="{Binding ActivePack.Questions[0].IncorrectAnswer[2]}" Width="150" Padding="5 5 5 5" Margin="0 0 15 15"/>
        </WrapPanel>
    </Grid>
</UserControl>
