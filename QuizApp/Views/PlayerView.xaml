<UserControl x:Class="QuizApp.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizApp.Views"
             mc:Ignorable="d"
             FontSize="24"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock 
            Text="{Binding CurrentQuestion.Query}" 
            FontSize="24" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"/>
        <TextBlock
            Text="{Binding TimeRemainingSeconds}"
            FontSize="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"/>
        <Grid Grid.Row="1"
            Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Answer1"
                Grid.Row="0" Grid.Column="0"
                Command="{Binding CheckAnswerCommand}"
                CommandParameter="0"
                Margin="8"
                Padding="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="0">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IncorrectAnswerIndex}" Value="0">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Answers[0]}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="Answer2"
                Grid.Row="0" Grid.Column="1"
                Command="{Binding CheckAnswerCommand}"
                CommandParameter="1"
                Margin="8"
                Padding="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="1">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IncorrectAnswerIndex}" Value="1">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Answers[1]}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="Answer3"
                Grid.Row="1" Grid.Column="0"
                Command="{Binding CheckAnswerCommand}"
                CommandParameter="2"
                Margin="8"
                Padding="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="2">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IncorrectAnswerIndex}" Value="2">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Answers[2]}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Button>

            <Button x:Name="Answer4"
                Grid.Row="1" Grid.Column="1"
                Command="{Binding CheckAnswerCommand}"
                CommandParameter="3"
                Margin="8"
                Padding="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrectAnswerIndex}" Value="3">
                                <Setter Property="Background" Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IncorrectAnswerIndex}" Value="3">
                                <Setter Property="Background" Value="LightCoral"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Answers[3]}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
