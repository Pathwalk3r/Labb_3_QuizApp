<UserControl x:Class="QuizApp.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="10 5 10 10">
            <Label
                Content="{Binding ActivePack.Name}"/>

            <WrapPanel Margin="0,0,0,8">
                <Button Content="Edit pack"
                    Command="{Binding EditPackCommand}"
                    Margin="2"/>
                <Button Content="Add question"
                    Command="{Binding AddQuestionCommand}"
                    Margin="2"/>
                <Button Content="Remove question"
                    Command="{Binding RemoveQuestionCommand}"
                    Margin="2"/>
                <Button Content="Save pack"
                    Command="{Binding SavePackCommand}"
                    Margin="2"/>
            </WrapPanel>

            <ListBox 
                x:Name="QuestionBox" 
                Height="325"
                ItemsSource="{Binding ActivePack.Questions}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock 
                                Text="Question:"
                                FontWeight="Bold">
                            </TextBlock>
                            <TextBlock
                                Text="{Binding Query}">
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Question:"/>
            <TextBox Text="{Binding SelectedQuestion.Query, UpdateSourceTrigger=PropertyChanged}"
             Height="75"
             AcceptsReturn="True"
             TextWrapping="Wrap"/>

            <TextBlock Text="Correct answer:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding SelectedQuestion.CorrectAnswer, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Incorrect answer 1:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding SelectedQuestion.IncorrectAnswer[0], UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Incorrect answer 2:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding SelectedQuestion.IncorrectAnswer[1], UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Incorrect answer 3:" Margin="0,8,0,0"/>
            <TextBox Text="{Binding SelectedQuestion.IncorrectAnswer[2], UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Grid>
</UserControl>
