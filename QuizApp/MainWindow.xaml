<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizApp"
        xmlns:views="clr-namespace:QuizApp.Views"
        xmlns:vm="clr-namespace:QuizApp.ViewModels"
        mc:Ignorable="d"
        DataContext="MainWindowViewModel"
        Title="Quiz App" Height="450" Width="800"
        Background="Beige">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
            <views:StartView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
            <views:PlayerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
            <views:ConfigurationView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:MenuView Grid.Row="0"/>
        <!--<views:PlayerView 
            Grid.Row="1"
            Visibility="{Binding PlayerVisibility}"/>
        <views:StartView 
            Grid.Row="1"
            Visibility="{Binding StartVisibility}"/>
        <views:ConfigurationView 
            Grid.Row="1" 
            Visibility="{Binding ConfigurationVisibility}"/>-->

        <ContentControl 
            Grid.Row="1"
            Content="{Binding CurrentView}"/>
    </Grid>
    
</Window>
