<Application x:Class="QuizApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuizApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BitmapImage x:Key="QuizAppMainImage"
                     UriSource="pack://application:,,,/Images/QuizAppMainImage.png"/>
        <BitmapImage x:Key="OPTIONS"
             UriSource="pack://application:,,,/Images/OPTIONS.png"/>
        <BitmapImage x:Key="START"
     UriSource="pack://application:,,,/Images/START.png"/>
        <Style TargetType="{x:Type Button}"/>
    </Application.Resources>
</Application>
